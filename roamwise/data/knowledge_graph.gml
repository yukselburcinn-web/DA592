    name "Moulin Rouge"
    category "nightlife"
    lat 48.884167
    lon 2.332222
    avg_visit_minutes 120
    price_level 1
    popularity_score 4.92
    description "Moulin Rouge (, French: [mul&#603;&#771; &#641;u&#658;]; lit. 'Red Mill') is a cabaret in Paris, on the Boulevard de Clichy, at the Place Blanche, the intersection and end of the Rue Blanche. In 1889, the Moulin Rouge was co-founded by Charles Zidler and Joseph Oller, who also owned the Paris Olympia. The original venue was destroyed by fire in 1915, reopening in 1925 after rebuilding."
    destination_id "PAR"
    open_hour 18
    close_hour 2
    opening_hours_raw ""
  ]
  node [
