  node [
    id 17
    label "POI0019"
    type "POI"
    name "Le Chat Noir"
    category "nightlife"
    lat 48.88359
    lon 2.33413
    avg_visit_minutes 120
    price_level 1
    popularity_score 4.78
    description "Le Chat Noir (French pronunciation: [l&#601; &#643;a nwa&#641;]; French, 'The Black Cat') was a 19th century entertainment establishment in the bohemian Montmartre district of Paris. It was opened on 18 November 1881 by impresario Rodolphe Salis, and closed in 1897 not long after Salis' death. Le Chat Noir is thought to be the first modern cabaret: a nightclub where the patrons sat at tables and drank alcoholic beverages while being entertained by a variety show on stage."
    destination_id "PAR"
    open_hour 18
    close_hour 2
    opening_hours_raw ""
  ]
