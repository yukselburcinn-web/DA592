    type "POI"
    name "Berghain"
    category "nightlife"
    lat 52.5111
    lon 13.4431
    avg_visit_minutes 120
    price_level 1
    popularity_score 4.95
    description "Berghain (German: [&#712;b&#603;&#641;kha&#618;n]) is a nightclub in Berlin, Germany. It is named after its location near the border between Kreuzberg and Friedrichshain and is a short walk from Berlin Ostbahnhof main line railway station. Founded in 2004 by friends Norbert Thormann and Michael Teufele, it has since become one of the world's most famous clubs and has been called the world capital of techno."
    destination_id "BER"
    open_hour 18
    close_hour 2
    opening_hours_raw ""
  ]
  node [
