    category "nature"
    lat 52.516667
    lon 13.366667
    avg_visit_minutes 90
    price_level 0
    popularity_score 4.84
    description "The Tiergarten (German: [&#712;ti&#720;&#592;&#815;&#716;&#609;a&#641;tn&#809;] , English: Animal Garden), formal German name: Gro&#223;er Tiergarten (English: Greater Animal Garden, or deer park, game hunting park), is a prominent park in Berlin's inner-city area, located completely in the district of the same name. It is one of the most popular parks in the city and at 210 hectares (520 acres) in size, is among the largest urban gardens in Germany."
    destination_id "BER"
    open_hour 0
    close_hour 24
    opening_hours_raw "24/7"
  ]
  node [
