# Copy to .env, fill in your OWN key, and load it into your shell:
#
#   cp .env.example .env
#   $EDITOR .env
#   set -a; source .env; set +a
#
# .env is gitignored. This repository is public: a key committed once is a key
# that must be revoked, not deleted. Each team member uses their own key and
# their own quota -- nobody's calls should land on someone else's key (#7).

# Which narration engine to use: nvidia | anthropic | local | template
# Unset (or absent) means the offline template, which needs no key at all.
ROAMWISE_LLM=nvidia

# Your own NVIDIA key from build.nvidia.com.
NVIDIA_API_KEY=

# Optional. Defaults to meta/llama-3.1-8b-instruct; set this to any model your
# account can reach.
# NVIDIA_LLM_MODEL=meta/llama-3.1-8b-instruct

# Optional. Requests per minute this process allows itself, matching the free
# tier's 40. Set 0 to disable the limiter on a paid tier.
# ROAMWISE_LLM_RPM=40
