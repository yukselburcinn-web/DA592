venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
.streamlit/
~$*
roamwise/data/.cache/
roamwise/data/raw_osm/
roamwise/.cache/

# Per-city intermediates from roamwise/pipeline/build_catalogue.py;
# poi.csv is their union and is the file the app reads.
roamwise/data/*_poi.csv

# Per-city outputs of roamwise/pipeline/gold_list.py. Regenerated from
# Wikivoyage on demand, and the measurement they support is reported in
# REPORT.md rather than read from these files by anything.
roamwise/data/gold_*.csv
roamwise/data/missed_*.csv

# Issue #71: Google Maps kazıma yerel bir deney. Çıktısı da aracı da
# depoya girmiyor — poi.csv temiz kalıyor, ToS ihlali commit edilmiyor.
local/

# Claude Code'un geliştiriciye özel izin dosyası. Paylaşılan kurallar
# .claude/settings.json'da ve commit edilir; bu dosya edilmez.
.claude/settings.local.json

# Oturum devir notları — tek bir günün fotoğrafı, hızla bayatlıyor. Kalıcı
# olması gereken kısmı CLAUDE.md'ye, ölçüm olan kısmı REPORT.md'ye yazın.
HANDOFF.md

# API keys. Each developer keeps their own in .env (see .env.example) and
# loads it into their own shell; nothing here is ever committed. The repo is
# public, and a key pushed once is a key that has to be revoked (#7).
.env
.env.*
!.env.example
